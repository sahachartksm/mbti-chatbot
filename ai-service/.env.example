# ── Google Gemini (Chat Mode) ─────────────────────────────────────────────────
# รับ API key ได้จาก https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model (default: gemini-2.0-flash — เร็ว + ประหยัด quota)
# ตัวเลือก: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ── AI Service ────────────────────────────────────────────────────────────────
AI_PORT=8000

# ── SBERT (Keyword Fallback เมื่อไม่มี Gemini) ───────────────────────────────
USE_SENTENCE_TRANSFORMER=true
