# ===============================================
# MBTI Chatbot — Environment Variables (example)
# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามต้องการ
# ===============================================

# ---- MongoDB (ใช้กับ docker-compose + backend) ----
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DB=mbti
# URI ที่ backend ใช้ (ต้องตรงกับ user/pass ข้างบน)
MONGO_URI=mongodb://admin:admin123@localhost:27017/mbti?authSource=admin

# ---- Backend (Go) ----
BACKEND_PORT=8080
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:4200

# ---- AI Service (Python) ----
AI_PORT=8000
MODEL_PATH=./models/mbti_model.pkl
USE_SENTENCE_TRANSFORMER=true

# ---- Frontend (Angular) ----
# ใส่ใน src/environments/environment.ts ไม่ได้อ่านไฟล์ .env ตรง ๆ
# ใช้เป็น reference
FRONTEND_API_BASE=http://localhost:8080/api
