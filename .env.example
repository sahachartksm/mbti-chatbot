# ===============================================
# MBTI Chatbot — Environment Variables (example)
# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามต้องการ
# ===============================================

# ---- MongoDB (ใช้กับ docker-compose + backend) ----
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DB=mbti
# URI ที่ backend ใช้ (ต้องตรงกับ user/pass ข้างบน)
MONGO_URI=mongodb://admin:admin123@localhost:27017/mbti?authSource=admin

# ---- Backend (Go) ----
BACKEND_PORT=8080
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:4200

# ---- AI Service (Python) ----
AI_PORT=8000
MODEL_PATH=./models/mbti_model.pkl
# Legacy ML predictor — off by default in LLM mode (save ~2GB torch install)
USE_SENTENCE_TRANSFORMER=false

# ---- LLM (Ollama) ----
# ต้องติดตั้ง Ollama บนเครื่อง host ก่อน: https://ollama.com/download
# แล้ว pull รุ่น:  ollama pull scb10x/llama3.1-typhoon2-8b-instruct
# (ดู docs/10-llm-ollama-setup.md)
#
# เมื่อ ai-service รันใน Docker ต้องชี้ไปที่ host:
OLLAMA_URL=http://host.docker.internal:11434
# เมื่อ ai-service รันแบบ native (ไม่ใช้ Docker):
# OLLAMA_URL=http://localhost:11434
LLM_MODEL=scb10x/llama3.1-typhoon2-8b-instruct
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.3

# ---- Frontend (Angular) ----
# ใส่ใน src/environments/environment.ts ไม่ได้อ่านไฟล์ .env ตรง ๆ
# ใช้เป็น reference
FRONTEND_API_BASE=http://localhost:8080/api
